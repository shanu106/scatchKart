<%- include('./partials/header') %>

<div class="w-full  *:text-zinc-200 font-serif font-light flex flex-wrap  h-screen  ">

    <div class=" w-full md:w-1/4 b  flex h-36 md:h-screen flex-col items-start">
        <div class="flex flex-row justify-between w-full md:flex-col">
            <a class="bg-blue-500 md:mt-4 m-0 text-center md:text-2xl px-2 py-2 rounded-3xl text-base font-light text-zinc-200 md:" href="/owners/products"> Products</a>
            <a class="bg-blue-500 md:mt-4 m-0 text-center md:text-2xl px-2 py-2 rounded-3xl text-base font-light text-zinc-200 md:" href="">Create product</a>
            <a class="bg-blue-500 md:mt-4 m-0 text-center md:text-2xl px-2 py-2 rounded-3xl text-base font-light text-zinc-200 md:" href="/owners/usersdata">Users data</a>
        </div>
    </div>


<div class=" w-full md:w-3/4 ">
    
    <% if(users.length > 0){ %>
        <% users.forEach(user => { %>
            <div class="w-full h-auto mt-2 border-b-2    border-zinc-500   flex flex-wrap  ">
                <div class="md:w-1/5 w-full border-none md:border-r-2 border-zinc-500 h-1/3 md:h-full">
                    <div class="w-full md:h-1/4  h-1/2 block md:flex justify-center ">
                        <div class="w-20 h-20 rounded-full ">
                            <img class="w-full h-full object-cover rounded-full" src="data:image/jpeg;base64,<%=user.profile.toString('base64') %>" alt="<%=user.profile %>">
                        </div>
                    </div>
                    <div class="w-full h-1/2 md:h-4/5 overflow-hidden ">
                        <div class="w-full pt-12  h-1/3 border-none md:border-b-2 border-zinc-700 ">
                            <h3 class="w-full text-2xl text-zinc-300 text-center">Name : <%=user.fullname %></h3>
                            <h3 class="w-full text-sm text-zinc-300 text-center">Email : <%= user.email %></h3>
                            <h3 class="w-full text-2xl text-zinc-300 text-center">orders: <%= user.order.length %></h3>
                         
                        </div>
                    </div>
                </div>
                <div class="md:w-3/4 w-full flex  flex-wrap h-full">
                    <% if(orders.length > 0){ %>
            <% orders.forEach(order=>{ %>
        
         <% if(String(order.userid) == String(user._id)){ %>
            <div class="md:w-1/2 w-full flex flex-wrap p-2 justify-center  h-1/3 ">
        <% user.order.forEach(item=>{ %>
        
            <% }) %>
            <% const counts={}; %>
            <% let filterProduct = order.orders.filter((item,index)=>{ %>
        <% counts[item]=counts[item]?counts[item]+1:1; %>
        <% return order.orders.indexOf(item)===index %>
                <% }) %>
        
           <div class="w-full h-full flex border-sky-500 border-2 rounded-3xl">
            <div class="w-3/4 h-full flex flex-wrap justify-center pl-2 border-sky-500 border-r-2 ">
                <h2 class="w-full text-base text-zinc-300 font-serif"><span class="text-zinc-500">Order id :</span> <%=order.orderid%></h2>
            <h2 class="w-full text-base text-zinc-300 font-serif"><span class="text-zinc-500">Payment id :</span> <%=order.paymentid%></h2>
            <h2 class="w-full text-base text-zinc-300 font-serif"><span class="text-zinc-500">Total Amount :</span> ₹ <%=order.amount%></h2>
            <h2 class="w-full text-base text-zinc-300 font-serif"><span class="text-zinc-500">Order date :</span> <%= order.date.getDate()%>/<%= order.date.getMonth()+1%>/<%= order.date.getFullYear()%> |  <%= order.date.getHours()%>:<%= order.date.getMinutes()%>:<%= order.date.getSeconds()%></h2>
            <h2 class="w-full text-base text-zinc-300 font-serif"><span class="text-zinc-500">Delivery Date :</span> <%= 7+order.date.getDate()%>/<%=1+ order.date.getMonth()%>/<%= order.date.getFullYear()%></h2>
        </div>
        <div class="w-1/4 h-full">
            <h3>
                <%filterProduct.forEach(item=>{ %>
        
            
        <h3 class="w-full flex justify-evenly items-center md:text-base text-sm mt-1 text-zinc-200"><span class="text-[<%=item.textcolor %>]"><%=item.name %></span> <span class="text-xs font-mono">X</span><span><%=counts[item] %></span></h3>
        
                    <% }) %>
            </h3>
        </div>
           </div>
           <div class=" w-full h-auto flex flex-wrap justify-end">
            <h2>Deliver to : <%=order.adress.name %>,<%=order.adress.contact %>,<%=order.adress.adressLine1 %>,<%=order.adress.adressLine %></h2>
            <h2><%=order.adress.city %>,<%=order.adress.state %>,<%=order.adress.country %>,<%=order.adress.postalCode %>,</h2>
           </div>
        
            </div>
         <% } %>
               
            
                        <!-- <h2 class="w-full text-xl text-zinc-600 font-serif">No orders yet</h2> -->
                        
                        <% }) %>
                        <% }   %>
        
            </div>
        </div>
        
        
        
        
        <%}); %>
        
</div>
</div>
<% } %>
<div class="w-full  bottom-0 flex m  h-16 md:hidden "></div>

<%- include('./partials/footer') %>