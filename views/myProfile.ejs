<%- include('./partials/header') %>
<%   if(change.length > 0){ %>
    <div class="w-full h-10    ">
        <div class="  absolute flex justify-center top-5 md:-top-5 w-full left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md  font-light font-serif mt-28 md:mt-48">
            <span class="inline-block bg-zinc-500 px-2 py-4 rounded-xl mt-1 mb-1 w-auto text-zinc-200">
              
                <%= change %> 
            </span>
        </div>
    </div>
    <% } %>
    
    <!-- here  -->
    <div id="foram1" class="w-full  items-center hidden     h-screen md:m-auto mt-4   absolute z-20   ">
        <div  class="md:w-1/2 md:h-1/2  h-1/3   bg-zinc-500 md:mx-auto items-center flex flex-wrap     justify-center border-2 rounded-md 
    border-zinc-500  h-object-fit">
  
    <div class="w-full   h-12 justify-between flex">
        
        
       <i onclick="hide2()" class="fa-solid fa-x mark text-red-700 text-2xl ml-2 text-center  px-4 pt-2  rounded-[50%] cursor-pointer "></i>
       <label class=" text-2xl w-[90%] mr-8 mt-2  text-sky-700 font-serif font-light text-center text  " for="">Enter New Email</label>
    </div>
 
    <div class="md:w-2/3 w-full h-full  md:flex ">
         <form   action="/users/emailchange/<%=user._id%>" method="post"  class="flex flex-wrap  justify-center items-center  w-full h-full gap-8">
        <input id="adrsid" type="text" hidden  name="adressid">
        <input value="<%=user.email %>"   class="w-full   outline-none bg-transparent text-start ml-8 text-zinc-200  pl-4  text-lg  font-serif font-light  rounded-3xl  mt-4"  type="text" required  placeholder="Your Name" name="newEmail" id="">
        
        
        <button onclick="show()" class="bg-blue-500 py-2 font-serif font-light  px-2 rounded-md md:mb-40 mb-20 text-white">Change Email </button>
    </form>
</div>
</div>
</div>
    <div id="foram" class="w-full  items-center      h-screen md:m-auto mt-4 hidden   absolute z-20   ">
        <div  class="md:w-1/2 md:h-1/2  h-1/3   bg-zinc-500 md:mx-auto items-center flex flex-wrap     justify-center border-2 rounded-md 
    border-zinc-500  h-object-fit">
  
    <div class="w-full   h-12 justify-between flex">
        
        
       <i onclick="hide1()" class="fa-solid fa-x mark text-red-700 text-2xl ml-2 text-center  px-4 pt-2  rounded-[50%] cursor-pointer "></i>
       <label class=" text-2xl w-[90%] mr-8 mt-2  text-sky-700 font-serif font-light text-center text  " for="">Enter New Name</label>
    </div>
 
    <div class="md:w-2/3 w-full h-full  md:flex ">
         <form   action="/users/namechange/<%= user._id %>" method="post"  class="flex flex-wrap  justify-center items-center  w-full h-full gap-8">
        <input id="adrsid" type="text" hidden  name="adressid">
        <input value="<%=user.fullname %>"   class="w-full   outline-none bg-transparent text-start ml-8 text-zinc-200  pl-4  text-lg  font-serif font-light  rounded-3xl  mt-4"  type="text" required  placeholder="Your Name" name="newName" id="">
        
        
        <button onclick="show()" class="bg-blue-500 py-2 font-serif font-light  px-2 rounded-md md:mb-40 mb-20 text-white">Change name </button>
    </form>
</div>
</div>
</div>
<div id="Logout" class="w-full  items-center  hidden  justify-center    h-screen md:m-auto mt-4    absolute z-20   ">
    <div  class="md:w-1/2 md:h-1/2  h-1/5   bg-zinc-500 md:mx-auto items-center flex flex-wrap     justify-center border-2 rounded-3xl 
border-zinc-500  h-object-fit">

<div class="w-full   h-12 justify-between flex">
    
    
  
   <label class=" text-2xl w-[90%] mr-8 mt-2  text-sky-700 font-serif font-light text-center text  " for="">Alert</label>
</div>

<div class="md:w-2/3 w-full h-3/4 flex-wrap flex-row  items-start ">
    <p class="w-full text-center text-zinc-200 font-serif text-xl h-1/2">Do You Want To Logout</p>
    <div class=" flex justify-end h-auto -mt-4 gap-2">

        <a class="text-lg font-serif font-light text-zinc-700  border-2 border-zinc-600 px-2 py-3 rounded-3xl"> <button onclick="logouthide()" >Cancel</button></a>
        <a onclick="logouthide()" class="text-lg font-serif font-light text-zinc-200 bg-blue-500 px-2 py-4 rounded-3xl" href="/users/logout">Confirm</a>
    </div>
</div>
</div>
</div>
<div id="delete" class="w-full  items-center    hidden   h-screen md:m-auto mt-4 justify-center   absolute z-20   ">
    <div  class="md:w-1/2 md:h-1/2  h-1/5   bg-zinc-500 md:mx-auto items-center flex flex-wrap     justify-center border-2 rounded-md 
border-zinc-500  h-object-fit">

<div class="w-full   h-12 justify-between flex">
    
    
  
   <label class=" text-2xl w-[90%] mr-8 mt-2  text-sky-700 font-serif font-light text-center text  " for="">Alert</label>
</div>

<div class="md:w-2/3 w-full h-3/4 flex-wrap flex-row  items-start ">
    <p class="w-full text-center font-serif font-light text-zinc-200 text-xl h-1/2">Do You Want To Delete Your Account</p>
    <div class=" flex justify-end h-auto -mt-4 gap-2">
        <a onclick="deletehide()" class="text-lg font-serif font-light text-zinc-700 cursor-pointer  border-2 border-zinc-600 px-2 py-3 rounded-3xl">Cancel</a>
        <a onclick="deletehide()" class="text-lg font-serif font-light text-zinc-200 bg-red-500 px-2 py-4 rounded-3xl" href="/users/delete/<%=user._id %>">Confirm</a>
    </div>
</div>
</div>
</div>


</div>

<div class="h-full w-full  flex flex-wrap justify-center    relative ">
<div class="w-full h-48 border-b-2 border-gray-500 mt-12  flex justify-center">
    <% let a = "hidden"; %>
    <div class="w-44 h-44 rounded-[50%] ">
        <img class="w-full h-full object-cover rounded-full" src="data:image/jpeg;base64,<%=user.profile.toString('base64') %> " alt="ss">
        <span onmouseover="show()" onmouseleave="hide()"  onclick="document.getElementById('image').click()" class="absolute w-10 bg-white ml-16 cursor-pointer  rounded-[50%] text-center -mt-6 md:mt-[-2vw]"><i class="fa-regular fa-image object-cover text-center text-3xl"></i></span>
        <form class="bg-red" action="/users/addimg" enctype="multipart/form-data" method="post">
           
          
            <input id="image"  class="hidden" onchange="this.form.submit()"  type="file" name="image">
        </form>
        <span class="bg-slate-500 p-1 text-zinc-300 border-zinc-900 border-2 ml-16 absolute mt-4 hidden " id="lab" >Upload Image</span>
    </div>
</div>
<div class="md:w-1/3 w-full rounded-lg flex flex-wrap justify-between  h-96 mt-4 ">
  
 <div class="flex flex-wrap justify-between  w-full h-8  pb-2 pl-6 mt-4">
    <label class=" text-center text-2xl text-zinc-400 font-light font-serif w-1/3 h-full" for="">full Name</label>
    <h4  class="text-gray-100 text-2xl font-serif font-light text-center h-8 w-2/4  "><%= user.fullname %></h4>
    <button onclick="show1()"><i class="fa-regular fa-pen-to-square text-red-500 mr-4 w-1/4 text-3xl"></i></button>
 </div>
 <div class="flex flex-wrap justify-between w-full h-8     pl-6 ">
    <label class=" text-center text-2xl text-zinc-400 font-light font-serif w-1/4 h-full" for="">Email</label>
    <h4  class=" text-2xl border-none  text-center h-8 w-2/4  text-zinc-200 font-light font-serif"><%= user.email %></h4>
    <button onclick="show2()"><i class="fa-regular fa-pen-to-square text-red-500 mr-4 w-1/4 text-3xl"></i></button>
 </div>
 <div class="flex flex-wrap justify-center w-full h-8  pb-2 pl-6">
 <%  if(user.order.length == 0){  %>
      <a  class="text-2xl  text-center h-8 w-2/4  text-zinc-400 font-light font-serif" href="/users/orders/<%=user._id  %>"> NO Orders yet </a>

<%   } else {  %>

      <a  class=" text-2xl  text-center h-8 w-2/4  text-zinc-200 font-light font-serif" href="/users/orders/<%=user._id  %>"> <%= user.order.length %> orders   </a>
  <% }  %>
  
   

 </div>
 <div class="flex flex-wrap justify-center w-full h-8  pb-2 pl-6 ">
    <button onclick="logoutshow()"  class=" text-2xl  text-center h-8 w-2/4  text-red-300 font-light font-serif" >Logout</button>
 </div>
  
 <div class="flex flex-wrap justify-center w-full h-8  pb-2 pl-6 ">
    <button  class=" text-2xl  text-center h-8 w-2/4  text-red-700 font-light font-serif" onclick="deleteshow()">Delete account</button>
 </div>
</div>
</div>


<script>
function show(){
    document.getElementById('lab').style.display='flex';
    }
function hide(){
    document.getElementById('lab').style.display='none';
    }
    function show1(){
            document.getElementById("foram").style.display="flex";
            
        }
        function hide1(){
            document.getElementById("foram").style.display="none";
        }
    function show2(){
            document.getElementById("foram1").style.display="flex";
            
        }
        function hide2(){
            document.getElementById("foram1").style.display="none";
        }
    function logoutshow(){
            document.getElementById("Logout").style.display="flex";
            
        }
        function logouthide(){
            document.getElementById("Logout").style.display="none";
        }
    function deleteshow(){
            document.getElementById("delete").style.display="flex";
            
        }
        function deletehide(){
            document.getElementById("delete").style.display="none";
        }
</script>




<%- include('./partials/footer') %>